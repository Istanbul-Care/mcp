{
  "name": "@istanbul-care/content-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Istanbul Care multi-brand content admin (blog posts, SEO, internal links)",
  "type": "module",
  "bin": {
    "ic-content-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "check:translatable": "node scripts/check-translatable.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
