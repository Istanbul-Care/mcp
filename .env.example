# Credentials the login tool falls back to when none are passed explicitly.
# Shared default across brands:
ICMCP_EMAIL=you@istanbul-care.com
ICMCP_PASSWORD=

# Per-brand overrides win over the shared pair. The suffix is the project id
# upper-cased with dashes turned into underscores:
#   istanbul-care        -> ICMCP_EMAIL_ISTANBUL_CARE
#   albanian-hair-klinik -> ICMCP_EMAIL_ALBANIAN_HAIR_KLINIK
#   ic-dental-group      -> ICMCP_EMAIL_IC_DENTAL_GROUP
# The id is the one in src/config/projects.ts, not the brand's domain — AHC's
# id is spelled 'klinik', so a key built from 'clinic' is silently never read.
# ICMCP_EMAIL_IC_DENTAL_GROUP=
# ICMCP_PASSWORD_IC_DENTAL_GROUP=

# The locale that carries NO prefix on a brand's public site. Only set this
# when a brand's default is not what src/config/projects.ts says. The backend
# keeps it in DEFAULT_LANGUAGE_CODE and does not expose it over the API.
# ICMCP_DEFAULT_LANG_LUNESTE_CLINIC=en
